---
/**
 * * The hero component used on the homepage
 * * Takes an image as a prop
 */

// Utils
import Logo from "@assets/images/hero/LogoFull.svg?raw";
import { Picture } from "astro:assets";
import type { GetImageResult } from "astro";

interface Props {
    image: GetImageResult; // pre-optimized image from getImage()
}

const { image } = Astro.props as Props;
---

<!-- ============================================ --><!--                    Hero                      --><!-- ============================================ -->
<section id="hero-541">
    <div class="cs-container">
        <div class="cs-content">
            <div class="cs-logo" set:html={Logo} />
            <!-- <a href="" class="cs-button-solid"
                >Schedule Your Trial Lesson Today</a
            > -->
        </div>
    </div>
    <!--Background Color-->
    <Picture
        src={image.src}
        alt="new home"
        width={image.attributes.width}
        height={image.attributes.height}
        formats={["avif", "webp"]}
        priority
        pictureAttributes={{ class: "cs-background" }}
    />
</section>

<style lang="less">/*-- -------------------------- -->
<---           Hero             -->
<--- -------------------------- -*/

/* Mobile - 360px */
@media only screen and (min-width: 0rem) {
    #hero-541 {
        /* Centers button */
        text-align: left;
        /* 144px - 300px - leaving extra space for the navigation */
        padding: clamp(5.125rem, 1.95vw, 20.75rem) (16/16rem) 0;
        /* 130px - 200px */
        padding-bottom: clamp(1.125rem, 1.5vw, 1rem);
        position: relative;
        z-index: 1;

        .cs-background {
            width: 100%;
            height: 100%;
            display: block;
            position: absolute;
            top: 0;
            left: 0;
            z-index: -2;

            &:before {
                /* Overlay */
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: radial-gradient(
                    ellipse at center,
                    rgba(255, 255, 255, 0.2) 0%,   /* A: Start with 50% transparent white at the dead center */
        rgba(255, 255, 255, 0.3) 30%,  /* B: Fade it out quickly by 20% mark */
        var(--medium) 60%,             /* C: Start pulling in your medium color */
        var(--medium) 100%
                );
                -webkit-backdrop-filter: blur(2px);
                backdrop-filter: blur(2px);
                z-index: 1; /* Sits above the img */
                /* prevents the cursor from interacting with it */
                pointer-events: none;
            }

            img {
                position: absolute;
                top: 0;
                left: 0;
                height: 100%;
                width: 100%;
                object-fit: cover;
                z-index: -1; /* Sits below the overlay */
            }
        }

        .cs-container {
            width: 100%;
            max-width: (1280/16rem);
            margin: auto;
        }

        .cs-title {
            /* 39px - 61px */
            font-size: clamp(2.4375rem, 6.4vw, 3.8125rem);
            font-weight: 700;
            line-height: 1.2em;
            text-align: left;
            max-width: (829/16rem);
            /* 16px - 24px */
            margin: 0 auto clamp(1rem, 4vw, 1.5rem) 0;
            color: #fff;
            position: relative;
        }

        .cs-text {
            /* 16px - 20px */
            font-size: clamp(1rem, 1.95vw, 1.25rem);
            line-height: 1.5em;
            text-align: left;
            width: 100%;
            /* 464px - 622px */
            max-width: clamp(29rem, 60vw, 38.785rem);
            margin: 0 auto 0 0;
            /* 40px - 48px */
            margin-bottom: clamp(2.5rem, 4vw, 3rem);
            color: #fff;
        }

        .cs-button-solid {
            font-size: (16/16rem);
            line-height: (56/16rem);
            text-decoration: none;
            font-weight: 700;
            margin: auto;
            color: #fff;
            padding: 0 (24/16rem);
            background-color: var(--primary);
            border-radius: (4/16rem);
            display: inline-block;
            position: relative;
            z-index: 1;

            &:before {
                content: "";
                position: absolute;
                display: block;
                height: 100%;
                width: 0%;
                background: #000;
                opacity: 1;
                top: 0;
                left: 0;
                z-index: -1;
                border-radius: (4/16rem);
                transition: width 0.3s;
            }

            &:hover {
                &:before {
                    width: 100%;
                }
            }
        }
    }
}

                                
</style>
