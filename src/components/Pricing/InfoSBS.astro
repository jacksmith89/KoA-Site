---
import singlenote from "src/icons/single-note.svg";
import doublenote from "src/icons/double-note.svg";
import triplenote from "src/icons/triple-note.svg";
import musicstaff from "src/icons/music-staff.svg";
---

<!-- ============================================ --><!--                   Steps                      --><!-- ============================================ -->
<section id="steps-1173">
    <div class="cs-container">
        <div class="cs-content">
            <!-- <span class="cs-topper">Our Work Process</span> -->
            <h2 class="cs-title">Beyond the Bench</h2>
            <!-- <p class="cs-text">
                Lorem ipsum dolor, sit amet consectetur adipisicing elit. Culpa libero sint hic accusantium exercitationem, voluptatem officia quaerat velit quis ullam?
            </p> -->
        </div>
        <ul class="cs-card-group">
            <li class="cs-item">
                <picture class="cs-picture">
                    <img
                        class="cs-icon"
                        src={singlenote.src}
                        alt="icon"
                        width="40"
                        height="40"
                        loading="lazy"
                        decoding="async"
                        aria-hidden="true"
                    />
                </picture>
                <h3 class="cs-h3">Practice Pays</h3>
                <p class="cs-item-text">
                    Nothing directly impacts progress more than consistent practice. Students who practice consistently, tracked through the <b>Vivid Practice App</b> earn direct discounts on the following month's tuition.
                </p>
                <!-- <br />
                <a href="/about/" class="cs-button-solid">Practice Pays</a> -->
            </li>
            <li class="cs-item">
                <picture class="cs-picture">
                    <img
                        class="cs-icon"
                        src={doublenote.src}
                        alt="icon"
                        width="40"
                        height="40"
                        loading="lazy"
                        decoding="async"
                        aria-hidden="true"
                    />
                </picture>
                <h3 class="cs-h3">Vivid Practice App</h3>
                <p class="cs-item-text">
                    We use the <a href="https://vividpractice.com/" class="cs-link">Vivid Practice App</a> to provide students with clear assignments they can follow at home, supported with images, audio, and video, ensuring that practice time is always productive, organized, and engaging.
                </p>
                <!-- <br />
                <a href="/about/" class="cs-button-solid">Lessons & Pricing</a> -->
            </li>
            <li class="cs-item">
                <picture class="cs-picture">
                    <img
                        class="cs-icon"
                        src={triplenote.src}
                        alt="icon"
                        width="40"
                        height="40"
                        loading="lazy"
                        decoding="async"
                        aria-hidden="true"
                    />
                </picture>
                <h3 class="cs-h3">Equipment Rentals</h3>
                <p class="cs-item-text">
                    You don't need to own a grand piano to begin your journey. We offer keyboard rentals for students just starting out, as well as tablet rentals to ensure everyone can access our practice tools.
                </p>
                <br />
                <!-- <a href="/about/" class="cs-button-solid">Contact Us</a> -->
            </li>
        </ul>
        <a href="/about/" class="cs-button-solid"
            >Need More Info? Reach Out Today</a
        >
    </div>
    <!--Tire Screech-->
    <img
        class="cs-graphic"
        src={musicstaff.src}
        alt="icon"
        width="840"
        height="357"
        loading="lazy"
        decoding="async"
        aria-hidden="true"
    />
</section>

<style lang="less">
    /*-- -------------------------- -->
<---           Steps            -->
<--- -------------------------- -*/

    /* Mobile - 360px */
    @media only screen and (min-width: 0rem) {
        #steps-1173 {
            padding: var(--sectionPadding);
            overflow: hidden;
            position: relative;
            z-index: 1;

            .cs-container {
                width: 100%;
                /* changes to 1280px at tablet */
                max-width: (704/16rem);
                margin: auto;
                display: flex;
                flex-direction: column;
                align-items: center;
                /* 48px - 64px */
                gap: clamp(3rem, 6vw, 4rem);
            }

            .cs-content {
                /* set text align to left if content needs to be left aligned */
                text-align: center;
                width: 100%;
                display: flex;
                flex-direction: column;
                /* centers content horizontally, set to flex-start to left align */
                align-items: center;
            }

            .cs-text {
                font-size: var(--bodyFontSize);
                line-height: 1.5em;
                text-align: inherit;
                width: 100%;
                max-width: (650/16rem);
                margin: 0;
                color: var(--bodyTextColor);
            }

            .cs-card-group {
                width: 100%;
                margin: 0;
                padding: 0;
                display: grid;
                grid-template-columns: repeat(12, 1fr);
                gap: (20/16rem);
            }

            .cs-link {
                text-decoration: underline;
                color: var(--primary);
                }

            .cs-item {
                text-align: center;
                list-style: none;
                display: flex;
                grid-column: span 12;
                flex-direction: column;
                align-items: center;
                position: relative;
                transition:
                    transform 0.3s,
                    border-color 0.3s;

                &:hover {
                    transform: scale(1.1);
                    border-color: var(--primary);
                }

                &:last-of-type {
                    &:after {
                        display: none;
                    }
                }

                &:nth-of-type(even) {
                    &:after {
                        /* scaleX -1 flips it horizontally */
                        transform: rotate(-135deg) scaleX(-1);
                    }
                }

                // &:after {
                //     content: "";
                //     position: relative;
                //     display: block;
                //     /* 54px - 84px */
                //     width: clamp(3.375rem, 6vw, 5.25rem);
                //     height: clamp(3.375rem, 6vw, 5.25rem);
                //     margin-top: (20/16rem);
                //     background: url("https://csimg.nyc3.cdn.digitaloceanspaces.com/Icons/curved-arrow-light.svg");
                //     background-size: contain;
                //     background-position: center;
                //     background-repeat: no-repeat;
                //     opacity: 1;
                //     transform: rotate(135deg);
                // }
            }

            .cs-picture {
                margin-bottom: (24/16rem);
                width: (88/16rem);
                height: (88/16rem);
                border: 1px solid #858585;
                border-radius: 50%;
                display: flex;
                justify-content: center;
                align-items: center;
                transition:
                    transform 0.3s,
                    border-color 0.3s;
            }

            .cs-icon {
                width: (40/16rem);
                height: auto;
                display: block;
            }

            .cs-h3 {
                font-size: (20/16rem);
                line-height: 1.2em;
                text-align: inherit;
                margin: 0 0 (12/16rem) 0;
                color: var(--headerColor);
            }

            .cs-item-text {
                font-size: (16/16rem);
                line-height: 1.5em;
                text-align: inherit;
                max-width: (413/16rem);
                margin: 0;
                color: var(--bodyTextColor);
            }

            .cs-graphic {
                width: (840/16rem);
                height: auto;
                opacity: 0.1;
                position: absolute;
                top: (-80/16rem);
                left: (-80/16rem);
                z-index: -1;
                transform: rotate(-10deg);
            }
        }
    }

    /* Tablet - 768px */
    @media only screen and (min-width: 48rem) {
        #steps-1173 {
            .cs-container {
                max-width: (1280/16rem);
            }

            .cs-item {
                grid-column: span 4;

                &:nth-of-type(1) {
                    &:after {
                        transform: rotate(45deg);
                    }
                }

                &:nth-of-type(2) {
                    &:after {
                        transform: rotate(135deg) scaleX(-1);
                    }
                }

                &:after {
                    margin: 0;
                    position: absolute;
                    right: (-40/16rem);
                    top: 0;
                    transform: rotate(45deg);
                }
            }
        }
    }

    /* Dark Mode */
    @media only screen and (min-width: 0rem) {
        body.dark-mode {
            #steps-1173 {
                .cs-title,
                .cs-text,
                .cs-item-text,
                .cs-h3 {
                    color: var(--bodyTextColorWhite);
                }

                .cs-text,
                .cs-item-text {
                    opacity: 0.8;
                }

                .cs-graphic {
                    opacity: 0.9;
                }
            }
        }
    }
</style>
